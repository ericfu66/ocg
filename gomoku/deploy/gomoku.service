# systemd 服务（不用 Docker 时使用）
# 安装：sudo cp deploy/gomoku.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now gomoku
[Unit]
Description=Gomoku vs Rapfi AI
After=network.target

[Service]
Type=simple
User=gomoku
WorkingDirectory=/opt/gomoku/server
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=ENGINE_DIR=/opt/gomoku/engine
Environment=POOL_SIZE=2
Environment=HASH_MB=512
Environment=TOP_TIME_MS=20000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
